# -----------------------------------------------------------------------------
# Encore Live — environment config. Copy to .env (the `up` command does this
# for you). .env is gitignored: never commit real values.
# Staging/production differ from local ONLY by the values in this file.
# -----------------------------------------------------------------------------

# Ports on your machine
WP_PORT=8080
PMA_PORT=8081
MAILPIT_UI_PORT=8025

# Database (MySQL 8.0)
DB_NAME=encore
DB_USER=encore
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
DB_TABLE_PREFIX=wp_

# WordPress install (used by scripts/install.sh)
WP_URL=http://localhost:8080
WP_TITLE=Encore Live
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=admin@encore.test

# local | development | staging | production  (wp_get_environment_type())
WP_ENVIRONMENT_TYPE=local
# 1 = on, empty = off
WP_DEBUG=1

# Page cache (WP Super Cache). true in staging/production; also fine locally:
# logged-in users always bypass it.
WP_CACHE=true

# Outgoing mail (local: Mailpit catches everything)
ENCORE_SMTP_HOST=mailpit
ENCORE_SMTP_PORT=1025

<?xml version="1.0"?>
<ruleset name="Encore Live">
	<description>WordPress Coding Standards for Encore Live's own code only.</description>

	<!-- What we lint: our code, never WordPress core or third-party plugins. -->
	<file>./wp-content/plugins/encore-core</file>
	<file>./wp-content/themes/encore-theme</file>
	<file>./docker/wordpress/mu-plugins</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>

	<!-- PHP 8.2 and newer; WordPress 6.5 and newer. -->
	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Every translatable string must use one of our text domains. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="encore-core"/>
				<element value="encore-theme"/>
			</property>
		</properties>
	</rule>

	<!-- Every global (function, constant, hook) must be prefixed to avoid clashes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="encore"/>
				<element value="EncoreCore"/>
			</property>
		</properties>
	</rule>
</ruleset>
